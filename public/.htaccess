# Für IONOS Webspace / Deploy Now (Apache)
ErrorDocument 404 /404.html

# HTTPS-Weiterleitung bitte im IONOS-Kundenbereich aktivieren
# (Domain → SSL-Zertifikat → "HTTPS-Weiterleitung"), nicht hier –
# sonst kann es hinter dem IONOS-Proxy zu Weiterleitungsschleifen kommen.

# Bilder und gehashte Astro-Dateien lange cachen
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
