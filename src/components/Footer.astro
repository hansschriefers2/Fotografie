---
import Logo from "./Logo.astro";
import { legalNav, nav, orte, pixieset, site, weitereRegionen } from "../config";

const seiten = [
  ...nav,
  { href: "/gutschein/", label: "Gutschein" },
  ...(pixieset.galerieUrl ? [{ href: "/kundengalerie/", label: "Kundengalerie" }] : []),
];
---

<footer class="mt-auto bg-linen">
  <div class="container-page grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[4fr_5fr_2fr] lg:gap-16">
    <!-- Marke -->
    <div>
      <div class="inline-block"><Logo /></div>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-ink-soft">
        {site.tagline} in {site.region}. Natürliche Bilder, die eure Geschichte erzählen.
      </p>
      {
        site.instagram && (
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Schriefers Fotografie auf Instagram"
            class="mt-6 inline-block text-ink-soft transition-colors hover:text-rose-deep"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <path d="M17.5 6.5h.01" />
            </svg>
          </a>
        )
      }
    </div>

    <!-- Orte -->
    <div>
      <h2 class="eyebrow mb-4 font-sans">Orte in der Umgebung</h2>
      <ul class="flex flex-wrap gap-2" aria-label="Orte in der Umgebung">
        {
          orte.map((o) => (
            <li class="rounded-full border border-ink/10 bg-cream px-3 py-1 text-xs text-ink-soft">{o}</li>
          ))
        }
        <li class="rounded-full border border-dashed border-rose-deep/40 px-3 py-1 text-xs text-rose-deep italic">
          und viele mehr …
        </li>
      </ul>
      <h2 class="eyebrow mt-7 mb-4 font-sans">Außerdem regelmäßig in</h2>
      <ul class="flex flex-wrap gap-2" aria-label="Weitere Regionen">
        {
          weitereRegionen.map((r) => (
            <li class="rounded-full border border-ink/10 bg-cream px-3 py-1 text-xs text-ink-soft">{r}</li>
          ))
        }
      </ul>
    </div>

    <!-- Seiten -->
    <nav aria-label="Seiten">
      <h2 class="eyebrow mb-4 font-sans">Seiten</h2>
      <ul class="space-y-2 text-sm">
        {
          seiten.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-ink/10">
    <div
      class="container-page flex flex-col gap-4 py-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} {site.name}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
