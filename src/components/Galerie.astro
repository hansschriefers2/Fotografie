---
import { Image } from "astro:assets";
import type { Foto } from "../data/fotos";

interface Props {
  fotos: Foto[];
}

const { fotos } = Astro.props;
---

<div class="galerie">
  {
    fotos.map((foto) => (
      <figure>
        <Image
          src={foto.bild}
          alt={foto.alt}
          widths={[400, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 33vw"
          loading="lazy"
        />
        {foto.titel && <figcaption>{foto.titel}</figcaption>}
      </figure>
    ))
  }
</div>
