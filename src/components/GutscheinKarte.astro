---
// Gestalteter Gutschein im Format DIN A5 quer (210 × 148 mm).
// Alle Größen in cqw (Prozent der Kartenbreite) – sieht auf der Website und im Druck gleich aus.
// Leere Felder werden als Linien zum Ausfüllen gezeigt.
import { Image } from "astro:assets";
import gutscheinFoto from "../assets/gutschein/gutschein.jpg";
import { site } from "../config";

interface Props {
  fuer?: string;
  von?: string;
  wert?: string;
  gueltigBis?: string;
  nr?: string;
  /** Druckversion: ohne Rundung und Schatten */
  druck?: boolean;
}
const { fuer = "", von = "", wert = "", gueltigBis = "", nr = "", druck = false } = Astro.props;
// Foto: DSC09997 (Babyhand), leicht unscharf – warme Stimmung, die alle anspricht
const foto = { src: gutscheinFoto, fokus: "19% 60%" };
const sizes = (n: number) => (druck ? `${n * 20}px` : `${Math.round(n * 2.6)}px`);

const felder = [
  { label: "Für", wert: fuer },
  { label: "Von", wert: von },
  { label: "Über", wert },
];
---

<div
  class:list={[
    "@container relative aspect-[210/148] w-full overflow-hidden bg-cream text-ink",
    druck ? "" : "rounded-[2cqw] shadow-[0_30px_60px_-25px_rgba(63,53,49,0.45)]",
  ]}
>
  <!-- Deko -->
  <div class="absolute top-[9cqw] left-[44cqw] size-[3cqw] rounded-full bg-rose/50" aria-hidden="true"></div>

  <!-- Foto im Bogen rechts -->
  <div class="absolute top-[7cqw] right-[5cqw] bottom-0 w-[33cqw] overflow-hidden rounded-t-full bg-sand">
    <Image src={foto.src} alt="" widths={[500, 900, 1600]} sizes={sizes(33)} class="h-full w-full scale-110 object-cover blur-[0.35cqw]" style={{ objectPosition: foto.fokus }} />
  </div>
  <div class="absolute right-0 bottom-0 h-[18cqw] w-[9cqw] rounded-tl-full bg-rose/40" aria-hidden="true"></div>

  <!-- Inhalt -->
  <div class="absolute inset-y-0 left-0 flex w-[58cqw] flex-col px-[7cqw] pt-[7cqw] pb-[5.5cqw]">
    <svg viewBox="-4 14 128 88" class="w-[5cqw]" fill="none" stroke="#a8655e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 30h18l8-12h28l8 12h18a10 10 0 0 1 10 10v44a10 10 0 0 1-10 10H10A10 10 0 0 1 0 84V40a10 10 0 0 1 10-10z" /><circle cx="50" cy="61" r="22" /><circle cx="50" cy="61" r="13" />
    </svg>
    <p class="mt-[2.2cqw] font-serif text-[9.5cqw] leading-[0.95]">Gutschein</p>
    <p class="mt-[1cqw] font-serif text-[3.4cqw] text-ink-soft italic">für ein Fotoshooting</p>

    <dl class="mt-[3.5cqw] space-y-[2.1cqw]">
      {
        felder.map((f) => (
          <div class="flex items-end gap-[1.5cqw]">
            <dt class="w-[6.5cqw] shrink-0 text-[1.45cqw] font-semibold tracking-[0.2em] text-rose-deep uppercase">{f.label}</dt>
            <dd class="min-h-[3.2cqw] flex-1 border-b border-ink/25 pb-[0.3cqw] font-serif text-[2.7cqw] leading-none">{f.wert}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-auto flex items-end justify-between gap-[3cqw]">
      <div class="leading-none">
        <p class="font-serif text-[3.3cqw]">Schriefers</p>
        <p class="mt-[0.7cqw] pl-[0.42em] text-[1.25cqw] font-semibold tracking-[0.42em] text-rose-deep uppercase">Fotografie</p>
      </div>
      <div class="text-right text-[1.3cqw] leading-relaxed text-ink-soft">
        <p>Gültig bis: <span class="inline-block min-w-[11cqw] border-b border-ink/25 text-left font-medium text-ink">{gueltigBis}</span></p>
        <p>Nr.: <span class="inline-block min-w-[11cqw] border-b border-ink/25 text-left font-medium text-ink">{nr}</span></p>
        <p class="mt-[0.4cqw]">www.{site.email.split("@")[1]}</p>
      </div>
    </div>
  </div>
</div>
