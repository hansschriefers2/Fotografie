---
import Logo from "./Logo.astro";
import { nav, anfrageHref } from "../config";

const pfad = Astro.url.pathname;
const istStart = pfad === "/";
const aktiv = (href: string) => (href === "/" ? pfad === "/" : pfad.startsWith(href));
---

<header
  data-header
  data-home={istStart ? "true" : "false"}
  data-solid={istStart ? "false" : "true"}
  class="group/h fixed inset-x-0 top-0 z-40 transition-[background-color,box-shadow] duration-500 data-[solid=true]:bg-cream/95 data-[solid=true]:shadow-[0_1px_0_rgba(63,53,49,0.08)] data-[solid=true]:backdrop-blur"
>
  <div class="container-page flex h-18 items-center justify-between sm:h-20">
    <Logo />

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-9">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={aktiv(item.href) ? "page" : undefined}
                class="relative py-2 text-sm font-medium tracking-wide text-ink transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-rose-deep after:transition-transform after:duration-300 group-data-[solid=false]/h:text-cream group-data-[solid=false]/h:after:bg-cream hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={anfrageHref}
            class="btn bg-ink px-5 py-2.5 text-cream hover:bg-rose-deep group-data-[solid=false]/h:bg-cream/90 group-data-[solid=false]/h:text-ink group-data-[solid=false]/h:hover:bg-cream"
          >
            Termin anfragen
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
      class="group/btn relative -mr-2 flex h-11 w-11 items-center justify-center text-ink group-data-[solid=false]/h:text-cream md:hidden"
    >
      <span class="relative block h-3.5 w-6">
        <span
          class="absolute top-0 left-0 block h-px w-6 bg-current transition-transform duration-300 group-aria-expanded/btn:top-1.5 group-aria-expanded/btn:rotate-45"
        ></span>
        <span
          class="absolute top-1.5 left-0 block h-px w-6 bg-current transition-opacity group-aria-expanded/btn:opacity-0"
        ></span>
        <span
          class="absolute top-3 left-0 block h-px w-6 bg-current transition-transform duration-300 group-aria-expanded/btn:top-1.5 group-aria-expanded/btn:-rotate-45"
        ></span>
      </span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="invisible fixed inset-x-0 top-18 bottom-0 bg-cream opacity-0 transition-[opacity,visibility] duration-300 group-data-[open=true]/h:visible group-data-[open=true]/h:opacity-100 md:hidden"
  >
    <nav aria-label="Mobile Navigation" class="container-page flex h-full flex-col pt-10 pb-12">
      <ul class="space-y-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-2 font-serif text-4xl text-ink"
                aria-current={pfad === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={anfrageHref} class="btn-primary mt-auto w-full">Termin anfragen</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const button = header.querySelector<HTMLButtonElement>("[data-menu-button]")!;
  const istStart = header.dataset.home === "true";
  let offen = false;

  const update = () => {
    header.dataset.solid = String(!istStart || offen || window.scrollY > 40);
    header.dataset.open = String(offen);
    button.setAttribute("aria-expanded", String(offen));
    button.setAttribute("aria-label", offen ? "Menü schließen" : "Menü öffnen");
    document.body.style.overflow = offen ? "hidden" : "";
  };

  button.addEventListener("click", () => {
    offen = !offen;
    update();
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && offen) {
      offen = false;
      update();
    }
  });
  window.addEventListener("scroll", update, { passive: true });
  update();
</script>
