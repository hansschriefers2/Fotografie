---
// Bindet ein Pixieset-Formular (Buchung oder Kontakt) direkt ein.
// Darunter ein kurzer Datenschutz-Hinweis und der Link zum Öffnen in einem neuen Tab.
interface Props {
  url: string;
  titel: string;
  hoehe?: number;
}

const { url, titel, hoehe = 900 } = Astro.props;
---

<div>
<div class="overflow-hidden rounded-[1.75rem] bg-white shadow-[0_1px_0_rgba(63,53,49,0.06)]">
  <iframe
    src={url}
    title={titel}
    loading="lazy"
    class="block w-full border-0 bg-white"
    style={`height: ${hoehe}px`}
  ></iframe>
</div>
<p class="mt-4 text-xs leading-relaxed text-ink-soft">
  Das Formular wird von Pixieset bereitgestellt (siehe
  <a href="/datenschutz/" class="underline underline-offset-2 hover:text-ink">Datenschutzerklärung</a>). Probleme beim Laden?
  <a href={url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-ink">Formular in neuem Tab öffnen</a>.
</p>
</div>
