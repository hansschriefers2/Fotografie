---
// Bindet ein Pixieset-Formular (Buchung oder Kontakt) DSGVO-freundlich ein:
// Der iframe wird erst nach einem Klick geladen ("Zwei-Klick-Lösung"),
// vorher fließen keine Daten an Pixieset. Ohne JavaScript bleibt der direkte Link.
interface Props {
  url: string;
  titel: string;
  hoehe?: number;
}

const { url, titel, hoehe = 900 } = Astro.props;
---

<div
  class="overflow-hidden rounded-[1.75rem] bg-linen"
  data-pixieset-embed
  data-src={url}
  data-titel={titel}
  style={`--hoehe: ${hoehe}px`}
>
  <div class="p-8 sm:p-10">
    <p class="font-serif text-3xl">{titel}</p>
    <p class="mt-4 max-w-lg leading-relaxed text-ink-soft">
      Das Formular wird von <strong class="text-ink">Pixieset</strong> bereitgestellt. Beim Laden werden Daten an Pixieset
      übertragen (siehe <a href="/datenschutz/" class="text-rose-deep underline underline-offset-2">Datenschutzerklärung</a>).
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn-primary" data-laden>Formular laden</button>
      <a class="btn-ghost" href={url} target="_blank" rel="noopener">In neuem Tab öffnen</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-pixieset-embed]").forEach((box) => {
    box.querySelector("[data-laden]")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = box.dataset.src ?? "";
      iframe.title = box.dataset.titel ?? "Pixieset";
      iframe.className = "block w-full border-0 bg-white";
      iframe.style.height = "var(--hoehe, 900px)";
      box.replaceChildren(iframe);
    });
  });
</script>
