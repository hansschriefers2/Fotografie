---
// Bindet ein Pixieset-Formular (Buchung oder Kontakt) DSGVO-freundlich ein:
// Der iframe wird erst nach einem Klick geladen ("Zwei-Klick-Lösung"),
// vorher fließen keine Daten an Pixieset. Ohne JavaScript bleibt der direkte Link.
interface Props {
  url: string;
  titel: string;
  hoehe?: number;
}

const { url, titel, hoehe = 900 } = Astro.props;
---

<div class="embed" data-pixieset-embed data-src={url} data-titel={titel} style={`--hoehe: ${hoehe}px`}>
  <div class="embed-hinweis">
    <p>
      Das Formular wird von <strong>Pixieset</strong> bereitgestellt. Beim Laden werden Daten an Pixieset übertragen
      (siehe <a href="/datenschutz/">Datenschutzerklärung</a>).
    </p>
    <div class="knopf-reihe">
      <button type="button" class="knopf knopf-voll" data-laden>Formular laden</button>
      <a class="knopf" href={url} target="_blank" rel="noopener">In neuem Tab öffnen</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-pixieset-embed]").forEach((box) => {
    box.querySelector("[data-laden]")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = box.dataset.src ?? "";
      iframe.title = box.dataset.titel ?? "Pixieset";
      iframe.loading = "lazy";
      box.replaceChildren(iframe);
    });
  });
</script>
