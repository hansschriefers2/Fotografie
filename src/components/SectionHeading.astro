---
// Titel kann HTML enthalten (z. B. <em>), daher über den Slot "title" oder als Text.
interface Props {
  eyebrow: string;
  title?: string;
  center?: boolean;
}
const { eyebrow, title, center = false } = Astro.props;
const hatText = Astro.slots.has("default");
---

<div class={center ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-4xl sm:text-5xl">{title}<slot name="title" /></h2>
  {
    hatText && (
      <div class="mt-5 text-base leading-relaxed text-ink-soft sm:text-lg">
        <slot />
      </div>
    )
  }
</div>
