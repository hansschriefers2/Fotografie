---
import "../styles/global.css";
import { studio, navigation } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = studio.beschreibung } = Astro.props;
const seitenTitel = title ? `${title} – ${studio.name}` : `${studio.name} · Familienfotografie`;
const pfad = Astro.url.pathname;
const canonical = Astro.site ? new URL(pfad, Astro.site).href : undefined;
const jahr = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={seitenTitel} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="kopf">
      <a href="/" class="marke">{studio.name}</a>
      <nav aria-label="Hauptnavigation">
        {
          navigation.slice(1).map((item) => (
            <a href={item.href} aria-current={pfad === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="fuss">
      <span>© {jahr} {studio.name} · {studio.region}</span>
      <span class="fuss-links">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        {studio.instagram && <a href={studio.instagram} rel="noopener">Instagram</a>}
      </span>
    </footer>
  </body>
</html>
