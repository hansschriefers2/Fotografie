---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.beschreibung, noindex = false } = Astro.props;
const seitenTitel = title ? `${title} | ${site.name}` : `${site.name} – ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/og-image.jpg", Astro.site).href : "/og-image.jpg";
---

<!doctype html>
<html lang="de" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f4" />
    <title>{seitenTitel}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seitenTitel} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name} – ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#inhalt"
      class="sr-only z-50 rounded-full bg-ink px-4 py-2 text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Zum Inhalt springen
    </a>
    <Header />
    <main id="inhalt" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
