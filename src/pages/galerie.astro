---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Gallery from "../components/Gallery.astro";
import { galeriePhotos } from "../data/fotos";
---

<Layout
  title="Galerie"
  seoTitel="Galerie: Newborn-, Babybauch- & Familienfotos | Schriefers Fotografie"
  description="Einblicke in Newborn-, Babybauch- und Familienshootings in Pforzheim, Wurmberg und dem Enzkreis. Natürliche Bilder, draußen und bei euch zu Hause."
>
  <PageHeader
    eyebrow="Galerie"
    title="Kleine Momente, große Gefühle"
    intro="Ein Einblick in meine Arbeit. Tippt auf ein Bild, um es groß anzusehen."
  />
  <section class="container-page py-16 sm:py-20">
    <Gallery photos={galeriePhotos} />
  </section>
</Layout>
