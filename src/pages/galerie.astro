---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Gallery from "../components/Gallery.astro";
import { allPhotos } from "../data/fotos";
---

<Layout title="Galerie" description="Einblicke in Baby-, Familien- und Babybauchshootings von Schriefers Fotografie.">
  <PageHeader
    eyebrow="Galerie"
    title="Kleine Momente, große Gefühle"
    intro="Ein Einblick in meine Arbeit – natürlich, warm und zeitlos. Tippt auf ein Bild, um es groß anzusehen."
  />
  <section class="container-page py-16 sm:py-20">
    <Gallery photos={allPhotos} />
  </section>
</Layout>
