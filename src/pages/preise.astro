---
// Öffentliche, bewusst knappe Preisseite. Alle Details stehen im Preisguide (/preisguide/),
// der nicht verlinkt ist und auf Anfrage per Link verschickt wird.
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { photos } from "../data/fotos";
import { abPreis, euro, fotosInklusive, inklusive, kombis, shootings } from "../data/preise";
import { site } from "../config";

const kombiAb = Math.min(...kombis.map((k) => k.preis));
---

<Layout title="Preise" description={`Shootings bei ${site.name} ab ${euro(abPreis)} – mit ${fotosInklusive} bearbeiteten Fotos, Vorgespräch und Online-Galerie.`}>
  <PageHeader
    eyebrow="Preise"
    title="Was ein Shooting kostet"
    intro="Jedes Shooting ist ein bisschen anders. Hier gibt es einen ersten Überblick."
  />

  <!-- Eckdaten -->
  <section class="container-page py-16 sm:py-24">
    <dl class="grid gap-6 md:grid-cols-3">
      <div class="rounded-[1.75rem] bg-ink p-8 text-cream sm:p-10">
        <dt class="text-xs font-semibold tracking-[0.25em] text-rose uppercase">Shootings</dt>
        <dd class="mt-4 font-serif text-6xl"><span class="text-2xl text-cream/70">ab </span>{euro(abPreis)}</dd>
      </div>
      <div class="rounded-[1.75rem] bg-linen p-8 sm:p-10">
        <dt class="eyebrow">Immer inklusive</dt>
        <dd class="mt-4 font-serif text-6xl">{fotosInklusive} <span class="text-2xl text-ink-soft">Fotos</span></dd>
      </div>
      <div class="rounded-[1.75rem] bg-linen p-8 sm:p-10">
        <dt class="eyebrow">Kombipakete</dt>
        <dd class="mt-4 font-serif text-6xl"><span class="text-2xl text-ink-soft">ab </span>{euro(kombiAb)}</dd>
      </div>
    </dl>

    <div class="mt-20 grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Shootings</p>
        <h2 class="mt-4 text-4xl sm:text-5xl">Was ich für euch festhalte</h2>
        <ul class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
          {
            shootings.map((s) => (
              <li class="flex items-baseline justify-between gap-6 py-4">
                <span class="font-serif text-2xl">{s.name}</span>
                <span class="shrink-0 text-sm text-ink-soft">{s.dauer}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">Immer dabei</p>
        <h2 class="mt-4 text-4xl sm:text-5xl">In jedem Paket</h2>
        <ul class="mt-8 space-y-4">
          {
            inklusive.map((x) => (
              <li class="flex gap-4 leading-relaxed text-ink-soft">
                <span aria-hidden="true" class="text-rose-deep">✓</span>
                <span><strong class="font-semibold text-ink">{x.titel}:</strong> {x.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Preisguide anfordern -->
  <section class="bg-linen py-20 sm:py-28">
    <div class="container-page grid items-center gap-12 lg:grid-cols-[5fr_6fr] lg:gap-20">
      <div class="relative aspect-[3/2] overflow-hidden rounded-[2rem]">
        <Image
          src={photos.familie11.src}
          alt={photos.familie11.alt}
          widths={[500, 800, 1100]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="absolute inset-0 h-full w-full bg-sand object-cover"
        />
      </div>
      <div>
        <p class="eyebrow">Preisguide</p>
        <h2 class="mt-4 text-4xl sm:text-5xl">Alle Details auf einen Blick</h2>
        <p class="mt-5 max-w-xl leading-relaxed text-ink-soft">
          Im Preisguide findet ihr alle Pakete und Preise, die Kombipakete, Extras, den Ablauf und Antworten auf die
          häufigsten Fragen. Schreibt mir kurz über das Kontaktformular, dann schicke ich ihn euch gern persönlich zu.
        </p>
        <div class="mt-9">
          <a href="/kontakt/?preisguide" class="btn-primary">Preisguide anfordern</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
